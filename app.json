{
  "expo": {
    "name": "Reservas Deportivas",
    "slug": "reservas-deportivas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reservasdeportivas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "ar.edu.uner.reservasdeportivas"
    },
    "android": {
      "package": "ar.edu.uner.reservasdeportivas",
      "adaptiveIcon": {
        "backgroundColor": "#106048",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F9F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permití que Reservas Deportivas use la cámara para escanear el código QR de las reservas.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permití que Reservas Deportivas use tu ubicación para mostrarte los complejos deportivos cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permití que Reservas Deportivas acceda a tus fotos para cambiar la imagen de tu perfil.",
          "cameraPermission": "Permití que Reservas Deportivas use la cámara para sacar la foto de tu perfil.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permití que Reservas Deportivas use Face ID para proteger tu cuenta."
        }
      ],
      "expo-document-picker",
      "expo-sqlite",
      "expo-audio",
      "expo-video",
      "@react-native-vector-icons/ionicons",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
