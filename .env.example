# Plantilla de configuración. Copiala como ".env" en la raíz del proyecto:
#   Windows:   copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# Después de cambiarla, reiniciá Expo con: npx expo start -c

# true  = usa los datos inventados de src/mocks (no necesita backend).
# false = usa la API real definida en EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_USAR_MOCKS=true

# Solo se usa si EXPO_PUBLIC_USAR_MOCKS=false.
# Poné la IP de la compu que corre la API EN TU RED (no la de otra persona).
# Si probás en el celular, "localhost" NO sirve: sería el celular mismo.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Clave de Google Maps para Android (builds nativos; no la usa Expo Go).
# Se configura en Google Cloud con el package ar.edu.uner.reservasdeportivas
# y la huella SHA-1 del keystore. Si está vacía, la app compila igual pero el
# mapa no se muestra en Android.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
